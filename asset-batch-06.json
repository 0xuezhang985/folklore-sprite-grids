  "per_file_visual_notes": {
    "wick-poses-01.png": [
      "第4格已改为头顶火焰点灯，第6、8格头顶烛芯熄灭；动作帧脚底基线未做像素级对齐认证。"
    ],
    "caravan-seated-01.png": [
      "角色顺序已修正，六名家人均为坐姿；第6格食物偏圆形包子/饺子造型，未严格限定饺子褶形。"
    ],
    "reunion-props-01.png": [
      "前两格长桌额外带木凳；空桌/满桌未做像素级几何对齐。"
    ],
    "player-moves-02.png": [
      "武器为小叶刃；部分刀刃有暖色亮边，严格光线仅限物体内部的要求仍需检查。"
    ],
    "story-figures-01.png": [
      "第8格两人均已改成年轻全身像，但右侧妹妹仍带盘发结构，与第7格披发不完全一致。",
      "第2格为低蹲/下沉姿态，单膝跪姿不够明确。"
    ],
    "cg-memory-origin.png": [
      "人物、针尖与最后一针在上方；绣框下缘及支撑手的一小部分仍进入下方三分之一，关键针线交互不受影响。"
    ],
